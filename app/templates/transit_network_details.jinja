{% extends 'base.jinja'%}
{% from './_partials/_form_errors.jinja' import form_errors%}
{% set STATUS_BADGES = {
    'PENDING_AGGREGATION': 'badge-warning',
    'DATA_AVAILABLE': 'badge-success',
    'AGGREGATION_ERROR': 'badge-error',
    'OUT_OF_SERVICE': 'badge-ghost'
} %}
{% block content%}
<a href="/" class="btn btn-secondary mb-6">Retour</a>
<div class="bg-base-200 p-4 min-w-[50%] flex flex-col items-center">
    <h1 class="text-3xl font-bold text-neutral">Consultation du réseau de transport "{{transit_network_infos.get('name')}}"</h1>
    <div class="divider"></div>
    <div class="w-full max-w-lg flex items-center justify-between gap-4 mb-6">
        <div class="flex items-center gap-2">
            <span class="font-medium text-primary">État de l'agrégation</span>
            <span class="badge {{ STATUS_BADGES.get(transit_network_infos.get('status'), 'badge-ghost') }}">{{ transit_network_infos.get('statusLabel', 'Inconnu') }}</span>
        </div>
        <form method="post" action="/transit-networks/{{ transit_network_infos.get('externalId') }}/retrigger">
            <button type="submit" class="btn btn-secondary btn-sm">Relancer l'agrégation</button>
        </form>
    </div>
    <form method="post" action="" class="w-full max-w-lg">
        <div class="mb-4">
            {{ form.title.label(class_="font-medium text-primary") }}
            {{ form.title(class_="mt-1 w-full input input-primary") }}
            {{ form_errors(form.title.errors) }}
        </div>
        <div class="mb-4">
            {{ form.endpoint_url.label(class_="font-medium text-primary") }}
            {{ form.endpoint_url(class_="mt-1 w-full input input-primary") }}
            {{ form_errors(form.endpoint_url.errors) }}
        </div>
        <div class="mb-4">
            {{ form.external_id.label(class_="font-medium text-primary") }}
            {{ form.external_id(class_="mt-1 w-full input input-primary", readonly=true) }}
            {{ form_errors(form.external_id.errors) }}
        </div>
        <div class="mb-4">
            {{ form.country_code.label(class_="font-medium text-primary") }}
            {{ form.country_code(class_="mt-1 w-full input input-primary") }}
            {{ form_errors(form.country_code.errors) }}
        </div>
        <div class="mb-4">
            {{ form.city_or_region.label(class_="font-medium text-primary") }}
            {{ form.city_or_region(class_="mt-1 w-full input input-primary") }}
            {{ form_errors(form.city_or_region.errors) }}
        </div>
        <div class="mb-4">
            {{ form.description.label(class_="font-medium text-primary") }}
            {{ form.description(class_="mt-1 w-full input textarea textarea-primary", rows="4") }}
            {{ form_errors(form.description.errors) }}
        </div>
        <div class="flex justify-end">
            {{ form.csrf_token }}
            {{ form.submit(class_="btn btn-primary") }}
        </div>
    </form>
</div>
{% endblock%}
