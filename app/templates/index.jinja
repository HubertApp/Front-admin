{% extends 'base.jinja'%}
{% set STATUS_BADGES = {
    'PENDING_AGGREGATION': 'badge-warning',
    'DATA_AVAILABLE': 'badge-success',
    'AGGREGATION_ERROR': 'badge-error',
    'OUT_OF_SERVICE': 'badge-ghost'
} %}
{% block content%}
<div class="p-4 min-w-[50%] flex flex-col items-center">
    <div class="w-full">
        <h1 class="text-3xl font-bold text-neutral">Réseaux de transport</h1>
        <div class="divider"></div>
        <section class="w-full flex justify-between py-3">
            <label class="input">
                <svg class="h-[1em] opacity-50" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                    <g stroke-linejoin="round" stroke-linecap="round" stroke-width="2.5" fill="none"
                        stroke="currentColor">
                        <circle cx="11" cy="11" r="8"></circle>
                        <path d="m21 21-4.3-4.3"></path>
                    </g>
                </svg>
                <input type="search" class="grow" placeholder="Search" />
            </label>
            <a class="btn btn-primary" href="/transit-networks/create">Ajouter un réseau de transport</a>
        </section>
        <section class="py-3 flex flex-col items-center">
            <div class="w-full flex gap-3">
                <select class="select">
                    <option disabled selected>Filtrer par état</option>
                    <option>En ligne</option>
                    <option>Hors ligne</option>
                    <option>En intégration</option>
                </select>
                <select class="select">
                    <option disabled selected>Filtrer par type</option>
                    <option>GTFS</option>
                    <option>GTFS-RT</option>
                    <option>NetEX</option>
                    <option>GeoJSON</option>
                </select>
                <div class="w-full flex flex-1 justify-end">
                    <button class="btn btn-secondary btn-sm">Exporter CSV</button>
                </div>

            </div>

        </section>
        <section class="py-3">
            <div class="overflow-x-auto rounded-box border border-base-content/5 bg-base-100">
                <table class="table">
                    <thead>
                        <tr>
                            <th>ID Fournisseur</th>
                            <th>Titre</th>
                            <th>Description</th>
                            <th>Etat</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for network in data['items'] %}
                        <tr>
                            <th>{{ network.externalId }}</th>
                            <td><a href="/transit-networks/{{ network.externalId }}" class="cursor-pointer">{{ network.name }}</a></td>
                            <td>{{ network.description }}</td>
                            <td><span class="badge {{ STATUS_BADGES.get(network.status, 'badge-ghost') }}">{{ network.statusLabel }}</span></td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </section>
        <section class="flex flex-col items-center p-3">
            <div class="join">
                {% for i in range(1, data['totalPages']) %}
                {% if i == data['page'] %}
                <button class="join-item btn btn-md btn-active">{{ i }}</button>
                {% else %}
                <button class="join-item btn btn-md">{{ i }}</button>
                {% endif %}
                {% endfor %}
            </div>
        </section>
    </div>

</div>
{% endblock%}
